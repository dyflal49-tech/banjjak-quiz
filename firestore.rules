rules_version = '2';

// =====================================================================
// 반짝퀴즈 Firestore 보안 규칙 초안
// =====================================================================
// 이 파일은 backend.js 가 Firestore 를 쓰는 방식을 읽고 만든 "초안"입니다.
// 지금 Firebase 콘솔에 걸려 있는 규칙은 저장소에 없어서 비교하지 못했어요.
// [추측] 이라고 적힌 곳은 코드만 보고 짐작한 부분이니 콘솔 규칙과 맞춰 보세요.
//
// ⚠️ 중요: Firebase 프로젝트(claude-padlet)를 "우리반 보드"와 같이 씁니다.
//    Firestore 규칙은 프로젝트 전체에 하나뿐이라, 이 파일을 그대로 배포하면
//    우리반 보드 컬렉션 규칙이 사라져 보드가 멈춥니다(기본은 모두 거부).
//    배포할 때는 아래 "우리반 보드 규칙" 자리에 지금 콘솔 규칙을 붙여 넣어
//    한 파일로 합친 뒤 올리세요.
//
// 지키려는 것
//  1. 학생(익명 로그인)은 자기 uid 로만 답·참가·행동을 보낼 수 있다
//     (진행자 엔진은 inbox 문서의 uid 를 그대로 믿으므로 가장 중요).
//  2. 학생은 다른 학생의 개인 화면 문서(players/{uid})를 읽을 수 없다.
//  3. 게임 상태(공개 문서, 엔진 저장본), 퀴즈 원본(정답 포함), 리포트는
//     선생님만 쓰고, 엔진 저장본·퀴즈·리포트는 선생님만 읽는다.
//  4. 학생 출제는 문제 받기가 켜진 코드로만, 자기 이름으로만 낼 수 있다.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }

    // backend.js 의 TEACHER_EMAIL, isTeacher() 와 같은 기준.
    // [추측] 선생님 계정이 이메일/비밀번호 로그인이라고 보고 provider 를 'password' 로 묶었어요.
    //        email_verified 는 요구하지 않았습니다(확인 안 된 계정일 수 있어서).
    //        더 단단하게 하려면 이메일 대신 선생님 계정 uid 로 바꾸세요.
    function isTeacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'dyflal49@gmail.com';
    }

    function isSelf(u) {
      return signedIn() && request.auth.uid == u;
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function codeDoc(code) {
      return get(/databases/$(database)/documents/kq_codes/$(code));
    }

    function codeExists(code) {
      return code is string && exists(/databases/$(database)/documents/kq_codes/$(code));
    }

    // ---------- 퀴즈 원본 (정답 포함): 선생님만 ----------
    match /kq_quizzes/{quizId} {
      allow read, write: if isTeacher();
    }

    // ---------- 리포트: 선생님만 ----------
    match /kq_reports/{reportId} {
      allow read, write: if isTeacher();
    }

    // ---------- 학생 출제 코드 ----------
    // 학생은 코드를 알고 있을 때 그 문서 하나만 읽을 수 있음(get). 목록(list)은 막아
    // 다른 반 코드를 훑어보지 못하게 함.
    match /kq_codes/{code} {
      allow get: if signedIn();
      allow list, write: if isTeacher();
    }

    // ---------- 학생 출제 문제 ----------
    match /kq_submissions/{subId} {
      // 선생님은 전부, 학생은 자기가 낸 것만 (backend.js 의 mine() 쿼리는
      // authorUid == 내 uid 조건이 있어서 이 규칙으로 통과함)
      allow read: if isTeacher()
        || (signedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isTeacher() || (
        signedIn()
        && request.resource.data.keys().hasOnly(['quizId', 'code', 'authorUid', 'authorName', 'question', 'status', 'createdAt', 'at'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && str(request.resource.data.authorName, 15)
        && request.resource.data.authorName.size() > 0
        && request.resource.data.question is map
        && request.resource.data.at == request.time
        && codeExists(request.resource.data.code)
        && codeDoc(request.resource.data.code).data.accepting == true
        && codeDoc(request.resource.data.code).data.quizId == request.resource.data.quizId
      );

      // 채택·거절(status 변경)은 선생님만
      allow update: if isTeacher();

      // 학생은 아직 검토 전인 자기 문제만 지울 수 있음
      allow delete: if isTeacher()
        || (signedIn() && resource.data.authorUid == request.auth.uid && resource.data.status == 'pending');

      // [한계] "검토 대기 20개까지" 제한과 문제 내용 검사(E.normQuestion)는 규칙으로
      //        완전히 따라 할 수 없어 브라우저 코드에만 남아 있어요.
    }

    // ---------- 이미지 ----------
    match /kq_images/{imageId} {
      // 문제 화면에 보이는 이미지라 로그인한 누구나 하나씩 읽을 수 있음. 목록은 선생님만.
      allow get: if signedIn();
      allow list: if isTeacher();

      // 학생은 유효한(문제 받기가 켜진) 출제 코드가 있을 때만 올릴 수 있음.
      // [추측] backend.js 는 코드 형식(6자리)만 확인하고 존재·accepting 은 확인하지 않아요.
      //        학생 이미지는 문제 내기 화면에서만 올라간다고 보고 accepting 까지 요구했습니다.
      allow create: if (isTeacher() || (
          signedIn()
          && codeExists(request.resource.data.code)
          && codeDoc(request.resource.data.code).data.accepting == true
        ))
        && request.resource.data.keys().hasOnly(['data', 'code', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && str(request.resource.data.data, 700000)
        && request.resource.data.data.matches('^data:image/.*')
        && request.resource.data.at == request.time;

      allow update, delete: if isTeacher();
    }

    // ---------- 게임 ----------
    match /kq_games/{pin} {
      // 공개 화면 문서: PIN 을 아는 사람은 읽기(get), 목록(list)은 선생님만.
      // 이 문서에는 정답 공개 전 정답이 들어가지 않음(engine.js hostQuestion 확인).
      allow get: if signedIn();
      allow list, write: if isTeacher();

      // 학생별 화면 문서: 문서 id 가 학생 uid. 본인과 선생님만 읽기, 쓰기는 선생님(진행자 엔진)만.
      match /players/{playerUid} {
        allow get: if isSelf(playerUid) || isTeacher();
        allow list, write: if isTeacher();
      }

      // 엔진 저장본(문제·정답·전체 답안 포함): 선생님만.
      match /private/{docId} {
        allow read, write: if isTeacher();
      }

      // 학생 → 진행자 요청함. 학생은 "자기 uid 로 새 요청 만들기"만 가능.
      // 읽기·수정·삭제는 선생님만이라, 다른 학생의 답을 보거나 지우거나 고칠 수 없음.
      match /inbox/{msgId} {
        allow read, update, delete: if isTeacher();

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          // 진행자는 at 순서로 처리하고 마지막 시각을 기억하므로, 미래 시각 위조를 막기 위해 서버 시각만 허용
          && request.resource.data.at == request.time
          && request.resource.data.type in ['join', 'answer', 'action']
          && str(request.resource.data.reqId, 64)
          && request.resource.data.keys().hasOnly(['uid', 'type', 'reqId', 'at', 'nickname', 'avatar', 'rejoin', 'questionId', 'answer', 'kind', 'target'])
          && (!('nickname' in request.resource.data) || str(request.resource.data.nickname, 15))
          && (!('rejoin' in request.resource.data) || str(request.resource.data.rejoin, 64))
          && (!('questionId' in request.resource.data) || str(request.resource.data.questionId, 64))
          && (!('kind' in request.resource.data) || str(request.resource.data.kind, 20))
          // 게임 문서가 있는(진행 중인) PIN 으로만 보낼 수 있음
          && exists(/databases/$(database)/documents/kq_games/$(pin));

        // [한계] 같은 학생이 요청을 아주 많이 보내는 것(도배)은 규칙으로 막기 어려워요.
        //        answer/target/avatar 의 내용 검사는 진행자 엔진이 계속 맡습니다.
      }
    }

    // ---------- 우리반 보드 규칙 ----------
    // [추측] 같은 프로젝트를 쓰는 우리반 보드(claude-padlet)의 규칙이 여기에 들어가야 합니다.
    //        지금 콘솔에 있는 보드용 match 블록을 이 자리에 붙여 넣으세요.
    //        그 전에는 이 파일 단독 배포 금지.
  }
}
